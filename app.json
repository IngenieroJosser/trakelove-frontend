{
  "expo": {
    "name": "LoveTrack",
    "slug": "lovetrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lovetrack",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.josser.lovetrack",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "LoveTrack usa tu ubicación para mostrar tu posición exacta a la persona que autorizaste.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "LoveTrack necesita actualizar tu ubicación en segundo plano mientras decidas compartirla."
      }
    },
    "android": {
      "package": "com.josser.lovetrack",
      "adaptiveIcon": {
        "backgroundColor": "#7C3AED",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F6FB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 92
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LoveTrack usa tu ubicación para mostrar tu posición exacta a la persona que autorizaste.",
          "locationAlwaysAndWhenInUsePermission": "LoveTrack actualiza tu ubicación en segundo plano únicamente mientras decidas compartirla.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}